# ==============================================================================
# Aegis / Warden LLM Guardrail Environment Variables
# ==============================================================================

# Model and Detection Threshold
MODEL_PATH=jailbreak_detector_light.joblib
THRESHOLD=0.4909

# Service Ports
PORT=8001
API_URL=http://127.0.0.1:8001
STREAMLIT_PORT=8501
REACT_PORT=3000
LANDING_PORT=5173

# External LLM Providers (Optional - Builtin Fallback Engine is active by default)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Default LLM Provider: 'builtin', 'gemini', 'openai', 'groq', 'ollama'
DEFAULT_LLM_PROVIDER=builtin
DEFAULT_LLM_MODEL=
